# NestJS server
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
NODE_ENV=development

# Production requires HTTPS certificates. Set NODE_ENV=production and fill these paths.
# HTTPS_KEY_PATH=/absolute/path/to/server.key
# HTTPS_CERT_PATH=/absolute/path/to/server.crt

# Local MySQL (the nest_app@localhost account created during setup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nest_learning
DB_USER=nest_app
# Copy this file to .env and replace the value locally. Never commit .env.
DB_PASSWORD=replace-with-your-nest-app-password

# Local file storage. Use an absolute persistent path in production.
FILE_STORAGE_ROOT=./storage
FILE_MAX_SIZE_BYTES=52428800
FILE_USER_QUOTA_BYTES=1073741824
